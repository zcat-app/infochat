<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>app.zcat.infochat</groupId>
        <artifactId>infochat-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>infochat-messaging-adapter</artifactId>
    <packaging>jar</packaging>

    <!--
         infochat-messaging-adapter is a Provider-side library jar: the
         presentation-layer SPI types (MessagingAdapter, TranslationProvider,
         ProgressNotifier) plus the supporting enum and records, and the
         concrete adapters (SimpleX, Signal, InMemory — each in its own
         Tier-3 ticket). The SPI surface itself stays transport-agnostic; a
         concrete adapter layers only the dependency it needs. quarkus-arc
         is present so a config-bearing adapter (SignalConfig: an
         @ApplicationScoped @Startup bean reading infochat.adapters.signal.*)
         can self-validate at Provider boot — CDI bean discovery from this
         jar is Provider-side wiring (M1-035b/M1-105). Collector intentionally
         does NOT depend on this module per docs/design/01-architecture.md
         §1.2 — only Provider talks to messaging backends. All versions are
         BOM-managed via the parent's quarkus-bom import; no <version>
         appears on dependencies in this POM (M1-001 invariant).
    -->
    <dependencies>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <!--
             com.fasterxml.jackson.core:jackson-databind — required by
             SimpleXMessageCodec for parsing the simplex-chat WebSocket bot
             API's JSON envelopes (M1-103). Declared explicitly here so the
             library jar compiles without relying on a transitive that may
             change with future Quarkus extensions; mirrors the
             jackson-databind declaration in infochat-llm-adapter/pom.xml.
             Version BOM-managed via the parent's quarkus-bom import (no
             <version/> here, per the M1-001 invariant).
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                 Publish this module's test classes as a secondary test-jar
                 artifact so other modules can consume the protocol-shaped
                 test doubles (FakeSimpleXProcess, FakeSignalCli) in their
                 own integration tests. infochat-provider's
                 MultiAdapterProductionIT (M1-109) is the consumer: it
                 drives the production SimpleXAdapter + SignalAdapter beans
                 against these in-process fakes to exercise cross-adapter
                 blast-radius without needing real adapter binaries in CI.
                 The plain compile-time dependency on infochat-messaging-adapter
                 only exposes main-jar classes; the test-jar is the
                 mechanism that exposes test classes across module
                 boundaries (Maven test-classpath convention).
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <!--
                     Version pinned because no parent-level pluginManagement
                     entry exists for maven-jar-plugin; without a version
                     Maven warns and falls back to whatever the super-pom
                     resolves at build time. 3.4.2 matches the LTS line
                     paired with Maven 3.9.x (the same generation as the
                     failsafe 3.5.4 pin in infochat-provider).
                -->
                <version>3.4.2</version>
                <executions>
                    <execution>
                        <id>test-jar</id>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
