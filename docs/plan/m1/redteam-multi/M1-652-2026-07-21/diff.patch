+                     + " (group_id, slot_kind, slot_fired_at,"
+                     + "  tag_subscription_version, source_subscription_version,"
+                     + "  content, is_degraded, expires_at)"
+                     + " VALUES (?, 'morning', ?, 1, 1, 'fixture', false, ?)")) {
+            ps.setObject(1, groupId);
