diff --git a/infochat-llm-adapter/src/test/java/app/zcat/infochat/llm/routing/LlmRouterStartupGuardLanguageRouteDisclosureTest.java b/infochat-llm-adapter/src/test/java/app/zcat/infochat/llm/routing/LlmRouterStartupGuardLanguageRouteDisclosureTest.java
