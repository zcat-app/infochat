<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>app.zcat.infochat</groupId>
        <artifactId>infochat-parent</artifactId>
        <version>1.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>infochat-provider</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>app.zcat.infochat</groupId>
            <artifactId>infochat-core</artifactId>
        </dependency>
        <dependency>
            <groupId>app.zcat.infochat</groupId>
            <artifactId>infochat-llm-adapter</artifactId>
        </dependency>
        <dependency>
            <groupId>app.zcat.infochat</groupId>
            <artifactId>infochat-messaging-adapter</artifactId>
        </dependency>
        <!--
             Test-only dependency on infochat-messaging-adapter's test-jar
             (the secondary artifact published by its maven-jar-plugin
             test-jar execution). Exposes the protocol-shaped test doubles
             FakeSimpleXProcess and FakeSignalCli to MultiAdapterProductionIT
             (M1-109), which drives the production SimpleXAdapter +
             SignalAdapter beans against in-process fakes to exercise the
             cross-adapter blast-radius scenarios without needing real
             adapter binaries in CI.

             Version pinned inline (one-off exception to the M1-001
             BOM-managed-versions invariant): the parent's dependencyManagement
             entry for infochat-messaging-adapter covers the default
             <type>jar</type> form only; Maven does NOT inherit that
             version onto a <type>test-jar</type> request with the same
             groupId+artifactId (the classifier "tests" makes it a distinct
             artifact for management purposes). The two correct fixes are
             (a) inline ${project.version} here, or (b) add a second
             dependencyManagement entry for <type>test-jar</type> in the
             parent pom. (b) is out of M1-109's files_scope; (a) keeps
             the change in-scope and is a one-line localized exception.
        -->
        <dependency>
            <groupId>app.zcat.infochat</groupId>
            <artifactId>infochat-messaging-adapter</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>app.zcat.infochat</groupId>
            <artifactId>infochat-ssrf</artifactId>
        </dependency>
        <!--
             Test-only dependency on infochat-ssrf's test-jar (M1-374): the
             single shared loopback-permitting IpBlocklist factory
             (LoopbackPermittingBlocklist), used by the source/command tests
             (UrlProbe*, AddSource*) that must dial an in-process 127.0.0.1
             server. Same mechanism and same inline-${project.version}
             exception as the infochat-messaging-adapter test-jar dependency
             above (see that comment for the M1-001 rationale): the parent's
             <type>jar</type> management does not cover the <type>test-jar</type>
             classifier, so the version is pinned inline here.
        -->
        <dependency>
            <groupId>app.zcat.infochat</groupId>
            <artifactId>infochat-ssrf</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <!--
             quarkus-micrometer supplies the CDI MeterRegistry that
             infochat-llm-adapter's LlmMetrics injects (M1-321).
        -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-micrometer</artifactId>
        </dependency>
        <!--
             quarkus-micrometer-registry-prometheus exports that registry
             at /q/metrics — micrometer-core alone registers meters that
             nothing exports, leaving the endpoint a 404 (F-live-7).
        -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-micrometer-registry-prometheus</artifactId>
        </dependency>
        <!--
             Migrations live in infochat-core (M1-017); both services see them
             on classpath via their transitive dependency on infochat-core.
             Production Provider does not run them: the operator runs Collector
             first (which migrates), then Provider. quarkus-flyway below is
             test-scoped only — it applies V1/V2/V4 against Provider's
             DevServices container so @QuarkusTest sees the same schema shape
             as production, without coupling test fixtures to Collector's
             container.
        -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-caffeine</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-flyway</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
             quarkus-scheduler drives the HeartbeatScheduler @Scheduled tick
             that refreshes the heartbeat row's last_seen_at every
             ${infochat.heartbeat.interval} (D41 / docs/design/07-deployment.md
             §7.8.5).
        -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-scheduler</artifactId>
        </dependency>
        <!--
             quarkus-smallrye-health serves the liveness/readiness probes at
             /q/health/live and /q/health/ready (docs/spec/deployment.md
             §Health and observability; docs/design/07-deployment.md §7.12).
             Pulls in quarkus-vertx-http — the Provider's only HTTP surface;
             no application REST endpoints exist (Provider is user-facing
             via messaging adapters only).
        -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-health</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
             ArchUnit — backs OutboundChokepointArchTest, which fails the
             build if any provider main class other than OutboundDelivery
             or DigestDelivery.RecordingAdapter calls the mutating
             MessagingAdapter methods (send/update/finalizeMessage),
             guarding the outbound chokepoint routing invariant
             (docs/spec/security.md §"Sanitizer output never contains ](").
             Test-scope only; production classpath is untouched.
        -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <version>1.4.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                 NullAway + Error Prone (decision D48). The full config lives in
                 the parent <pluginManagement> and Maven applies it to the
                 lifecycle compile execution of EVERY module, so infochat-provider
                 needs NO activation stanza for its MAIN sources — they are gated
                 by NullAway:ERROR via the inherited config. Onboarded by subticket
                 M1-164f.

                 TEST-SOURCE POLICY: main sources are gated by NullAway:ERROR
                 (inherited config). Test sources are NOT onboarded yet — the
                 default-testCompile execution below clears the inherited
                 compilerArgs so Error Prone / NullAway does not run on
                 src/test. Onboarding the test tree is deferred to a follow-up;
                 gating main first is what this ticket validates green. This
                 stanza exists ONLY to carry that test-source exclusion.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <compilerArgs combine.self="override"/>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.platform.version}</version>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                            <goal>generate-code</goal>
                            <goal>generate-code-tests</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
                 Failsafe wires *IT tests into the integration-test / verify
                 phases. The M1-007 umbrella IT (AllSpisLoadIT) lives here
                 because Provider transitively depends on all three new SPI
                 modules and is the right place to assert their cross-module
                 visibility; surefire (which runs *Test) is unchanged here.
                 Version pinned to match the surefire pin in the parent pom
                 (M1-445) so the two test phases stay aligned.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.5.4</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
