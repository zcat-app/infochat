# Multi-stage JVM image for the Provider (M1-379).
#
# Hand-written on purpose: it keeps the pom files untouched, so no Quarkus
# container-image extension (a dependency that would need explicit approval) is
# added. The build runs entirely inside the image, so a public-test host needs
# only Docker — no host JDK 25 / Maven (07-deployment.md §7.7.2).
#
# Build context is the repo ROOT (set in docker-compose.yml), so the full
# multi-module reactor is available to the build stage.

# --- build stage: full JDK 25 + Maven, runs the reactor build ---
# maven:3.9-eclipse-temurin-25 pins JDK 25 (D1) and the Maven 3.9 line; an
# explicit tag, never `latest` (M1-004 pinned-tag precedent). A full JDK (not
# JRE) is required because the NullAway/Error Prone compiler config forks javac
# with --add-exports/--add-opens into jdk.compiler internals (root pom.xml).
FROM maven:3.9-eclipse-temurin-25 AS build
WORKDIR /build
COPY . .
# -am builds the Provider's upstream sibling modules too; -DskipTests because
# @QuarkusTest/*IT spin up Testcontainers/DevServices containers that need a
# Docker daemon unavailable inside `docker build`. Test integrity is enforced
# separately by the host `mvn -B verify` gate, not by this image build.
RUN mvn -B -pl infochat-provider -am clean install -DskipTests

# --- runtime stage: JRE 25 only, runs the Quarkus fast-jar ---
FROM eclipse-temurin:25-jre
WORKDIR /app
# curl is the in-container loopback health probe the compose healthcheck runs:
# quarkus.http.host=127.0.0.1 binds /q/health to loopback, and the JRE base
# ships neither curl nor wget.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
# --- messaging-client binaries (M1-388) ---
# The Provider drives both clients as OS subprocesses inside this container
# (SimpleXSubprocess / SignalSubprocess, D46), and each adapter's .binary config
# (default /usr/local/bin/<name>, §7.4) must point at an existing executable or
# the adapter fails validate() at startup. Bake both in, pinned to explicit
# upstream release tags (M1-004 pinned-tag precedent), fetched over TLS and
# verified against a build-time sha256 so a changed upstream artifact fails the
# build non-zero (M1-394 integrity spirit). One RUN layer, placed above the app
# COPY so an app-only rebuild reuses it; the signal-cli archive is removed in the
# same layer so it never reaches the image.
#   simplex-chat v7.0.0: ubuntu-22_04-x86_64 dynamic Haskell binary; links only
#     libs already in the Ubuntu base (verified ldd: libgmp/libcrypto.so.3/libzstd).
#   signal-cli   0.14.5: JVM distribution, runs on this image's JRE 25.
ENV SIMPLEX_CHAT_VERSION=v7.0.0 \
    SIGNAL_CLI_VERSION=0.14.5
RUN SIMPLEX_CHAT_SHA256=393279f37a57ff7a63b92cffbd583d1d8abb5ea13e28f8caea74539d7c8db91d \
    && SIGNAL_CLI_SHA256=62d38ebfef3988d78f437e7328183b75ee549d111382e66c1af70d3ebd3cd7a7 \
    && curl -fsSL -o /usr/local/bin/simplex-chat \
        "https://github.com/simplex-chat/simplex-chat/releases/download/${SIMPLEX_CHAT_VERSION}/simplex-chat-ubuntu-22_04-x86_64" \
    && echo "${SIMPLEX_CHAT_SHA256}  /usr/local/bin/simplex-chat" | sha256sum -c - \
    && chmod +x /usr/local/bin/simplex-chat \
    && curl -fsSL -o /tmp/signal-cli.tar.gz \
        "https://github.com/AsamK/signal-cli/releases/download/v${SIGNAL_CLI_VERSION}/signal-cli-${SIGNAL_CLI_VERSION}.tar.gz" \
    && echo "${SIGNAL_CLI_SHA256}  /tmp/signal-cli.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/signal-cli.tar.gz -C /opt \
    && ln -s "/opt/signal-cli-${SIGNAL_CLI_VERSION}/bin/signal-cli" /usr/local/bin/signal-cli \
    && rm -f /tmp/signal-cli.tar.gz
# Default Quarkus fast-jar layout: quarkus-run.jar resolves lib/, app/, and
# quarkus/ relative to itself, so the whole quarkus-app/ dir is copied as a unit.
COPY --from=build /build/infochat-provider/target/quarkus-app/ ./
EXPOSE 8081
ENTRYPOINT ["java", "-jar", "quarkus-run.jar"]
