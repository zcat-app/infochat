<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>app.zcat.infochat</groupId>
    <artifactId>infochat-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>infochat-core</module>
        <module>infochat-ssrf</module>
        <module>infochat-llm-adapter</module>
        <module>infochat-messaging-adapter</module>
        <module>infochat-collector</module>
        <module>infochat-provider</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <quarkus.platform.version>3.33.1.1</quarkus.platform.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!--
                 infochat-core is the reactor-local shared SPI module.
                 Listing it here keeps downstream module POMs version-less
                 (preserves the M1-001 BOM-managed-versions invariant).
            -->
            <dependency>
                <groupId>app.zcat.infochat</groupId>
                <artifactId>infochat-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!--
                 infochat-ssrf is the shared SSRF-gated outbound HTTP/WS
                 client module. Both Collector (every feed fetch + future
                 StreamSource connect) and Provider (every /add-source URL
                 probe) depend on it. Same reactor-local pattern: management
                 here keeps consumers version-less per the M1-001 invariant.
            -->
            <dependency>
                <groupId>app.zcat.infochat</groupId>
                <artifactId>infochat-ssrf</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!--
                 infochat-llm-adapter is the LLM-side SPI module (LlmProvider,
                 EmbeddingProvider). Same reactor-local pattern as infochat-core:
                 management here keeps consumers (collector, provider, future
                 impl modules) version-less.
            -->
            <dependency>
                <groupId>app.zcat.infochat</groupId>
                <artifactId>infochat-llm-adapter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!--
                 infochat-messaging-adapter is the Provider-side presentation-layer
                 SPI module (MessagingAdapter, TranslationProvider, ProgressNotifier).
                 Same reactor-local pattern: management here keeps the Provider
                 consumer and future messaging-impl modules version-less.
            -->
            <dependency>
                <groupId>app.zcat.infochat</groupId>
                <artifactId>infochat-messaging-adapter</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
