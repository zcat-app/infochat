<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>app.zcat.infochat</groupId>
        <artifactId>infochat-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>infochat-ssrf</artifactId>
    <packaging>jar</packaging>

    <!--
         infochat-ssrf is a plain library jar: the SSRF-gated outbound
         HTTP client (IP blocklist, DNS-rebind defense, redirect cap,
         scheme allowlist, body-size cap) shared by Collector and Provider
         per docs/spec/security.md §SSRF and outbound connections + decision
         D20. NO Quarkus extensions live here — the wrapper uses only the
         JDK (java.net.http.HttpClient, java.net.InetAddress). JUnit is
         BOM-managed via the parent's quarkus-bom import; no <version>
         appears on dependencies in this POM (M1-001 invariant).
    -->
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                 Module-DAG enforcement (docs/design/09-reference.md §9.1): the
                 three sibling shared modules — infochat-ssrf,
                 infochat-llm-adapter, infochat-messaging-adapter — MUST NOT
                 depend on each other. maven-enforcer bannedDependencies
                 evaluates per running module, so the rule banning the OTHER two
                 siblings lives HERE; a parent-level ban would also break
                 infochat-collector / infochat-provider, which depend on these
                 siblings legitimately. Mirrors the proven collector→
                 messaging-adapter execution. Version is managed in the parent
                 <pluginManagement>. Build-time only; no effect on the shipped
                 runtime artifact.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>ban-sibling-shared-modules</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>app.zcat.infochat:infochat-llm-adapter</exclude>
                                        <exclude>app.zcat.infochat:infochat-messaging-adapter</exclude>
                                    </excludes>
                                    <message>infochat-ssrf must not depend on its sibling shared modules (infochat-llm-adapter, infochat-messaging-adapter) — the three siblings form a no-cross-edge DAG (module-DAG rule, docs/design/09-reference.md §9.1).</message>
                                </bannedDependencies>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                 NullAway + Error Prone (decision D48). The full config lives in
                 the parent <pluginManagement> and Maven applies it to the
                 lifecycle compile execution of EVERY module, so infochat-ssrf
                 needs NO activation stanza for its MAIN sources — they are gated
                 by NullAway:ERROR via the inherited config (M1-164b).

                 TEST-SOURCE POLICY: main sources are gated by NullAway:ERROR
                 (inherited config). Test sources are NOT onboarded yet — the
                 default-testCompile execution below clears the inherited
                 compilerArgs so Error Prone / NullAway does not run on
                 src/test, matching the infochat-core precedent (M1-164a).
                 This stanza exists ONLY to carry that test-source exclusion.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <compilerArgs combine.self="override"/>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                 Publish this module's test classes as a secondary test-jar
                 artifact so infochat-collector and infochat-provider can
                 consume the single shared loopback-permitting IpBlocklist
                 factory (LoopbackPermittingBlocklist) in their own tests
                 (M1-374). The factory must live in package
                 app.zcat.infochat.ssrf to reach IpBlocklist's package-private
                 carve-out constructor; the plain compile-time dependency on
                 infochat-ssrf exposes only main-jar classes, so the test-jar
                 is the mechanism that exposes the test factory across module
                 boundaries (Maven test-classpath convention). Mirrors the
                 proven infochat-messaging-adapter test-jar consumed by
                 infochat-provider (M1-109).
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <!--
                     Version pinned because no parent-level pluginManagement
                     entry exists for maven-jar-plugin; without a version Maven
                     warns and falls back to whatever the super-pom resolves at
                     build time. 3.4.2 matches the pin in
                     infochat-messaging-adapter's identical test-jar execution.
                -->
                <version>3.4.2</version>
                <executions>
                    <execution>
                        <id>test-jar</id>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
