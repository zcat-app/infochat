<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>app.zcat.infochat</groupId>
        <artifactId>infochat-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>infochat-ssrf</artifactId>
    <packaging>jar</packaging>

    <!--
         infochat-ssrf is a plain library jar: the SSRF-gated outbound
         HTTP client (IP blocklist, DNS-rebind defense, redirect cap,
         scheme allowlist, body-size cap) shared by Collector and Provider
         per docs/spec/security.md §SSRF and outbound connections + decision
         D20. NO Quarkus extensions live here — the wrapper uses only the
         JDK (java.net.http.HttpClient, java.net.InetAddress). JUnit is
         BOM-managed via the parent's quarkus-bom import; no <version>
         appears on dependencies in this POM (M1-001 invariant).
    -->
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                 NullAway / Error Prone opt-out (decision D48, M1-164a). The
                 parent <pluginManagement> entry activates Error Prone on the
                 lifecycle compile execution of every reactor module; this
                 module is not onboarded yet, so override the inherited
                 compilerArgs to empty and restore non-forked compilation —
                 Error Prone / NullAway does not run here and the module builds
                 exactly as it did before D48. Removed (and the module's genuine
                 nullness findings resolved) by subticket M1-164b.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <fork>false</fork>
                    <compilerArgs combine.self="override"/>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
