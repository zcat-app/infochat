<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>app.zcat.infochat</groupId>
        <artifactId>infochat-parent</artifactId>
        <version>1.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>infochat-core</artifactId>
    <packaging>jar</packaging>

    <!--
         infochat-core is a plain library jar: SPI types and shared
         primitives only. NO Quarkus extensions live here so that
         downstream Quarkus apps stay in charge of which extensions
         their runtime pulls in. JUnit is BOM-managed via the parent's
         quarkus-bom import; no <version> appears on dependencies in
         this POM (M1-001 invariant). The testcontainers-bom imported
         below extends BOM management to the schema-test stack the
         M1-008 umbrella + subtickets need without pinning per-artifact
         versions inline.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>1.21.4</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!--
             CDI annotation API on the compile classpath. M1-041 adds
             @ApplicationScoped on AuditLogWriter + DefaultRedactionHook
             and @Inject on AuditLogWriter#redactionHook. infochat-core
             remains a plain library jar at runtime — these deps are
             provided-scope so the CDI runtime is supplied downstream
             (infochat-provider + infochat-collector pull in quarkus-arc).
             Same shape as infochat-llm-adapter/pom.xml.
        -->
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!--
             ThrottledAdminNotifier (relocated from infochat-collector in
             M1-082) uses MicroProfile Config (@ConfigProperty), JBoss
             Logging (Logger), JSpecify (@Nullable), and javax.sql
             (DataSource). All provided-scope: the Quarkus runtime in
             collector/provider supplies the implementations.
        -->
        <dependency>
            <groupId>org.eclipse.microprofile.config</groupId>
            <artifactId>microprofile-config-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jboss.logging</groupId>
            <artifactId>jboss-logging</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-core</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
             ThrottledAdminNotifierTest is a @QuarkusTest (relocated with
             the production class in M1-082). It needs the Quarkus test
             runner, Agroal DataSource, and the Postgres JDBC driver.
             Test-scope only — the production artifact stays library-shaped.
        -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-agroal</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-flyway</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
             Schema-level tests (M1-008a §2.1 identity/audit) drive a
             real Postgres via Testcontainers and apply the V5 Flyway
             migration directly from src/main/resources/db/migration.
             infochat-core remains a plain library JAR in production
             scope (no Quarkus extensions); the Testcontainers /
             Postgres / Flyway dependencies are test-scope only so the
             production artifact stays library-shaped per M1-001.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                 Module-DAG enforcement (docs/design/09-reference.md §9.1): the
                 infochat-core row promises no user-facing surface and no
                 infochat-messaging-adapter dependency, and the DAG diagram puts
                 core in the leaf row with (none) dependencies. maven-enforcer
                 bannedDependencies evaluates per running module, so the rule
                 lives HERE (core only) — a parent-level ban would also break the
                 Provider, which depends on infochat-messaging-adapter
                 legitimately. Mirrors the proven collector→messaging-adapter
                 execution. Version is managed in the parent <pluginManagement>.
                 Build-time only; no effect on the shipped runtime artifact.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>ban-messaging-adapter-from-core</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>app.zcat.infochat:infochat-messaging-adapter</exclude>
                                    </excludes>
                                    <message>infochat-core must not depend on infochat-messaging-adapter — core promises no user-facing surface and no messaging dependency (module-DAG rule, docs/design/09-reference.md §9.1).</message>
                                </bannedDependencies>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                 NullAway + Error Prone (decision D48). The full config lives in
                 the parent <pluginManagement> and Maven applies it to the
                 lifecycle compile execution of EVERY module, so infochat-core
                 needs NO activation stanza for its MAIN sources — they are gated
                 by NullAway:ERROR via the inherited config. infochat-core is the
                 first module onboarded (M1-164a). Modules not yet onboarded
                 carry an Error-Prone opt-out in their own poms, removed by their
                 subtickets M1-164b..f.

                 TEST-SOURCE POLICY: main sources are gated by NullAway:ERROR
                 (inherited config). Test sources are NOT onboarded yet — the
                 default-testCompile execution below clears the inherited
                 compilerArgs so Error Prone / NullAway does not run on
                 src/test. Onboarding the test tree (resolving the @Nullable
                 Throwable.getMessage() and null-literal-arg findings across the
                 schema/audit tests) is deferred to a follow-up; gating main
                 first is what this ticket validates green. This stanza exists
                 ONLY to carry that test-source exclusion.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <compilerArgs combine.self="override"/>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                 maven-failsafe-plugin runs *IT.java tests during
                 `mvn verify`. Maven's default lifecycle does not bind
                 failsafe; this execution wires it so the M1-008
                 umbrella's PerScopeIsolationIT will run when added.
                 Surefire (test phase) remains bound by the super-pom
                 default and picks up *Test.java automatically.
            -->
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.5.2</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
