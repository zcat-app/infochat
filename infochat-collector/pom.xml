<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>app.zcat.infochat</groupId>
        <artifactId>infochat-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>infochat-collector</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>app.zcat.infochat</groupId>
            <artifactId>infochat-core</artifactId>
        </dependency>
        <dependency>
            <groupId>app.zcat.infochat</groupId>
            <artifactId>infochat-ssrf</artifactId>
        </dependency>
        <!--
             Test-only dependency on infochat-ssrf's test-jar (M1-374): the
             single shared loopback-permitting IpBlocklist factory
             (LoopbackPermittingBlocklist), used by the fetcher and
             stream/nostr tests that must dial an in-process 127.0.0.1 server.
             The plain compile-time infochat-ssrf dependency above exposes only
             main-jar classes; the test-jar exposes the test factory across the
             module boundary (Maven test-classpath convention).

             Version pinned inline (the same one-off exception to the M1-001
             BOM-managed-versions invariant taken for the messaging-adapter
             test-jar in infochat-provider, M1-109): the parent's
             dependencyManagement entry for infochat-ssrf covers the default
             <type>jar</type> form only; Maven does NOT inherit that version
             onto a <type>test-jar</type> request with the same
             groupId+artifactId (the "tests" classifier makes it a distinct
             artifact for management). Inline ${project.version} keeps the
             change in this module's pom rather than touching the parent.
        -->
        <dependency>
            <groupId>app.zcat.infochat</groupId>
            <artifactId>infochat-ssrf</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>app.zcat.infochat</groupId>
            <artifactId>infochat-llm-adapter</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <!--
             quarkus-micrometer supplies the CDI MeterRegistry that
             infochat-llm-adapter's LlmMetrics injects (M1-321). No
             registry exporter extension in v1 — the default composite
             registry is the committed surface.
        -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-micrometer</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-flyway</artifactId>
        </dependency>
        <!--
             quarkus-scheduler drives the HeartbeatScheduler @Scheduled tick
             that refreshes the heartbeat row's last_seen_at every
             ${infochat.heartbeat.interval} (D41 / docs/design/07-deployment.md
             §7.8.5).
        -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-scheduler</artifactId>
        </dependency>
        <!--
             quarkus-smallrye-health serves the liveness/readiness probes at
             /q/health/live and /q/health/ready (docs/spec/deployment.md
             §Health and observability; docs/design/07-deployment.md §7.12).
             The Collector needs only the extension defaults — the automatic
             Agroal datasource readiness check plus startup completing — and
             this dependency is its only HTTP surface (no user-facing API).
             Version BOM-managed.
        -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-health</artifactId>
        </dependency>
        <!--
             quarkus-messaging is the Quarkus 3.x umbrella for SmallRye
             Reactive Messaging core. Provides the in-memory channel
             runtime used by EvalQueueProducer (@Channel("eval-queue"))
             and consumed by T1-D's eval workers (CLAUDE.md §Stack, D4).
             Version BOM-managed; no <version/> here preserves the
             M1-001 BOM-managed-versions invariant.
        -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-messaging</artifactId>
        </dependency>
        <!--
             OWASP Java HTML Sanitizer — step 1 of the Stage 1
             ingest pipeline per docs/design/04-security.md §4.2.
             Allowlist HTML strip on feed bodies before Unicode
             normalization and the prompt-injection regex set.
             Version pinned here (no project-wide BOM coverage) at
             the latest stable release as of M1-032's authoring.
        -->
        <dependency>
            <groupId>com.googlecode.owasp-java-html-sanitizer</groupId>
            <artifactId>owasp-java-html-sanitizer</artifactId>
            <version>20240325.1</version>
        </dependency>
        <!--
             Apache Commons Text — used by Stage1Pipeline for the
             HTML-entity pre-decode step (StringEscapeUtils.unescapeHtml4).
             The pre-decode runs BEFORE NFKC + regex so the regex set
             sees fully-decoded text rather than entity-encoded forms
             that the OWASP sanitizer would later decode out of the
             regex's reach. Version pinned alongside OWASP (no BOM
             coverage). See Stage1Pipeline §"Step order".
        -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-text</artifactId>
            <version>1.12.0</version>
        </dependency>
        <!--
             Bouncy Castle (provider) — used by NostrEventVerifier for
             BIP-340 Schnorr signature verification on secp256k1. BC's
             public crypto/signers API does NOT expose a BIP-340
             verifier as of 1.80; the verifier hand-rolls the BIP-340
             framing (x-only pubkey lift, tagged-hash challenge,
             R = s·G − e·P check) on top of BC's secp256k1 curve
             parameters (SECNamedCurves.getByName("secp256k1")) and
             ECPoint math. Version pinned here (no project-wide BOM
             coverage) at the latest stable release as of M1-097's
             authoring. Scoped to collector only — Collector is forever
             read-only per D38, so no signing surface is ever needed.
        -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.80</version>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                 Module-DAG enforcement (docs/design/09-reference.md): the
                 Collector has no user-facing surface and MUST NOT depend on the
                 Provider-side presentation SPI infochat-messaging-adapter.
                 maven-enforcer bannedDependencies evaluates per running module,
                 so the rule lives HERE (collector only) — a parent-level ban
                 would also break the Provider, which depends on
                 infochat-messaging-adapter legitimately. Version is managed in
                 the parent <pluginManagement>. Build-time only; no effect on the
                 shipped runtime artifact.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>ban-messaging-adapter-from-collector</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>app.zcat.infochat:infochat-messaging-adapter</exclude>
                                    </excludes>
                                    <message>infochat-collector must not depend on infochat-messaging-adapter — the Collector has no user-facing surface and no messaging dependency (module-DAG rule, docs/design/09-reference.md).</message>
                                </bannedDependencies>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                 NullAway + Error Prone (decision D48). The full config lives in
                 the parent <pluginManagement> and Maven applies it to the
                 lifecycle compile execution of EVERY module, so this module's
                 MAIN sources need NO activation stanza — they are gated by
                 NullAway:ERROR via the inherited config (subticket M1-164e).

                 TEST-SOURCE POLICY: main sources are gated by NullAway:ERROR
                 (inherited config). Test sources are NOT onboarded yet — the
                 default-testCompile execution below clears the inherited
                 compilerArgs so Error Prone / NullAway does not run on
                 src/test, matching the infochat-core (M1-164a) policy. This
                 stanza exists ONLY to carry that test-source exclusion.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <compilerArgs combine.self="override"/>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.platform.version}</version>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                            <goal>generate-code</goal>
                            <goal>generate-code-tests</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
                 vertx.disableWebsockets=false pins vanilla Vert.x server-side
                 WebSocket support in both test JVMs. With quarkus-vertx-http
                 on the classpath, Quarkus's VertxHttpRecorder sets that
                 system property to true at boot (a request-path optimization
                 — Quarkus serves WebSockets through its own router, not the
                 vert.x webSocketHandler path) unless it is already set.
                 io.vertx.core.http.impl.HttpServerImpl latches the property
                 into a static final at class load, so a @QuarkusTest booting
                 first in the JVM silently breaks every later
                 Vertx.vertx().createHttpServer().webSocketHandler(...) fake
                 (FakeNostrRelay): the ws-only server's request handler stays
                 null and the handshake dies with an event-loop NPE.
                 Presetting the property at JVM start wins because the
                 recorder only sets it when absent. Test JVMs only — the
                 production Collector serves no WebSockets.
            -->
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <vertx.disableWebsockets>false</vertx.disableWebsockets>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <!--
                 maven-failsafe-plugin is bound here so *IT.java tests
                 (FlywayMigrationIT) run during `mvn verify`. Maven's
                 default lifecycle does not bind failsafe; without this
                 execution the integration-test/verify phases would skip
                 every IT and the file would be dead code on disk.
                 Surefire (test phase) runs *Test.java automatically; its
                 version is pinned in the parent pom (M1-445) because the
                 super-pom default on Maven 3.8.x is 2.12.4, which silently
                 discovers 0 JUnit 5 tests.
                 systemPropertyVariables: same vertx.disableWebsockets
                 pin as the surefire stanza above — the Nostr ITs spin
                 up FakeNostrRelay next to a booted @QuarkusTest
                 container in the same JVM.
            -->
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <systemPropertyVariables>
                        <vertx.disableWebsockets>false</vertx.disableWebsockets>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
